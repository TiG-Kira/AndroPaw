<!-- IOmxStore with no OMX codec, hosted by /system/bin/aemu-omxstore: on 11 MediaCodecList is empty without it -->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.media.omx</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IOmxStore</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
