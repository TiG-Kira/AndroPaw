service vendor.audio-hal /vendor/bin/hw/android.hardware.audio.service
    class hal
    user audioserver
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct
    # audioflinger restarts itself when it loses connection with the hal, so init need not
    oneshot
    interface android.hardware.audio@7.0::IDevicesFactory default
